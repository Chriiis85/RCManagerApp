{
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "cd client && npx ng build --configuration=production",
  "outputDirectory": "client/dist/RCManager/browser",
  "rewrites": [
    {
      "source": "/queue-times-api/(.*)",
      "destination": "/api/proxy?path=$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
